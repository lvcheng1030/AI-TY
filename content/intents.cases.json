{
  "version": 1,
  "note": "T4 意图解析用例：12 条意图 × 5 种说法 = 60 条。故意混入了容易互相命中的句子（见 note 字段），用来检验打分是否稳定。",
  "cases": [
    {
      "intent": "move_forward",
      "say": ["往前走", "向前走", "直走", "往前", "往前走一点"],
      "note": "最后一条与「往前走」编辑距离 2，应落到 0.85 档而不是 1.0"
    },
    {
      "intent": "move_left",
      "say": ["向左走", "往左", "左边", "往左边", "靠左"],
      "note": "「往左边」同时包含「往左」和「左边」两个同义词，检验并列命中时的稳定取值"
    },
    {
      "intent": "move_right",
      "say": ["向右走", "往右", "右边", "往右边", "靠右"],
      "note": "与 move_left 严格对称，防止左右规则写得不对称"
    },
    {
      "intent": "turn_left",
      "say": ["左转", "转左", "向左转", "向左转弯", "左转弯"],
      "note": "「向左转弯」「左转弯」都不是精确命中，靠「左转」的包含或距离命中，用来检验方向类不会被移动类抢走"
    },
    {
      "intent": "turn_right",
      "say": ["右转", "转右", "向右转", "向右转弯", "右转弯"],
      "note": "同 turn_left 的对称用例"
    },
    {
      "intent": "stop",
      "say": ["停", "停下", "别走", "停一下", "站住"],
      "note": "「站住」不在同义词表里，靠编辑距离 2 进 0.85 档；若这里失败说明距离算法有误"
    },
    {
      "intent": "read_sign",
      "say": ["读牌子", "这是什么牌子", "帮我读一下前方告示牌", "念牌子", "帮我读一下这个牌子"],
      "note": "最后一条靠「包含」命中 0.65 档，用来验证长句也能落地"
    },
    {
      "intent": "repeat",
      "say": ["再说一遍", "重复", "再念一遍", "再说一次", "重复一遍"],
      "note": "「再念一遍」与「再说一遍」编辑距离 1；「重复一遍」是包含命中"
    },
    {
      "intent": "where_am_i",
      "say": ["我在哪", "这是哪", "我在哪里", "这是什么地方", "我现在在哪"],
      "note": "「我现在在哪」包含「我在哪」，验证包含匹配不会串到别的意图"
    },
    {
      "intent": "look_ahead",
      "say": ["帮我看看前面", "前面有什么", "看看前面", "帮我看看", "帮我看看前方"],
      "note": "「帮我看看」是四条说法的共同前缀，检验最长匹配优先"
    },
    {
      "intent": "faster",
      "say": ["走快点", "快一点", "快点", "走快些", "再快点"],
      "note": "faster 与 slower 只差一个字，且「快点」「慢点」互为干扰项"
    },
    {
      "intent": "slower",
      "say": ["走慢点", "慢一点", "慢点", "走慢些", "再慢点"],
      "note": "与 faster 成对，任何一条错都会同时暴露两边"
    }
  ]
}
